# --- Build / local binaries ---
/dist/
/selfmind
/selfmind.exe
*.exe
*.test
*.out
*.prof
coverage.out
coverage.html
profile.cov

# Local Go build cache (repo-local GOCACHE)
/.gocache/

# --- Eval local diagnostics (never commit; cassettes live in .vcr/) ---
# AGENTS.md: JSONL traces under evalruns/ are local diagnostics.
evalruns/
# Captured real-user turns are private drafts until reviewed and promoted into
# evalcases/ + .vcr/. Keeping both roots ignored prevents accidental prompt or
# weak-assertion commits from diluting the release gate.
/evaldrafts/
/.vcr-drafts/

# Flight recorder dumps if ever written inside the repo
# (default path is ~/.selfmind/flight — keep this for overrides)
/flight/
/.flight/

# --- Secrets / local config (runtime data lives in ~/.selfmind) ---
.env
.env.*
!.env.example
*.pem
*.key
auth.json
credentials.json

# --- Private strategy docs (never publish; see docs ownership rules) ---
# Contains business strategy, security gap inventory, and IM platform risk
# discussion unsuitable for the public repository.
/docs/vision-saas-enterprise.zh-CN.md
/docs/onelinkai-cli-phase1-proposal.zh-CN.md

# --- Editor / OS / agent tooling ---
.claude/
!.claude/
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/selfmind-daily-driver-audit/
!.claude/skills/selfmind-daily-driver-audit/SKILL.md
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Temp / logs ---
/tmp/
*.tmp
# `*.tmp` does not match a `.tmp_` prefix, so a temp-named script could be
# committed permanently while advertising itself as scratch.
.tmp_*
*.log
*.tar.gz
*.tgz
/.npm-stage/
