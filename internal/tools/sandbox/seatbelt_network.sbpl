; SelfMind macOS exec sandbox — network additions.
;
; Appended only when Policy.Network is true. With it absent, `(deny default)`
; in the base policy already denies every socket operation, so egress is closed
; by omission rather than by a rule that could be reordered away.
;
; This is the analogue of NOT passing bwrap's `--unshare-net`.

(allow network*)

; AF_SYSTEM sockets used by local platform services.
(allow system-socket
  (require-all
    (socket-domain AF_SYSTEM)
    (socket-protocol 2)))

; Name resolution and TLS trust evaluation are separate services from the
; socket itself: without these, egress is permitted but every hostname fails to
; resolve and every certificate fails to validate.
(allow mach-lookup
  (global-name "com.apple.bsd.dirhelper")
  (global-name "com.apple.system.opendirectoryd.membership")
  (global-name "com.apple.SecurityServer")
  (global-name "com.apple.networkd")
  (global-name "com.apple.ocspd")
  (global-name "com.apple.trustd.agent")
  (global-name "com.apple.SystemConfiguration.DNSConfiguration")
  (global-name "com.apple.SystemConfiguration.configd"))
