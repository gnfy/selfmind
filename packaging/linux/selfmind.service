[Unit]
Description=SelfMind gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=selfmind
Group=selfmind
WorkingDirectory=/var/lib/selfmind
Environment=HOME=/var/lib/selfmind
ExecStart=/usr/local/bin/selfmind -f /etc/selfmind/config.yaml gateway run
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
KillSignal=SIGINT
StateDirectory=selfmind
LogsDirectory=selfmind
ConfigurationDirectory=selfmind
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/selfmind /var/log/selfmind /etc/selfmind

[Install]
WantedBy=multi-user.target
